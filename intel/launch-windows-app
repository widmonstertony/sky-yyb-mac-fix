#!/bin/zsh

set -u

mode="${1:-}"
if (( $# > 0 )); then
  shift
fi
extra_args=("$@")
support_root="$HOME/Library/Application Support/YYBIntelLauncher"
engine="$support_root/.runtime/wine-engine.app"
bridge="$engine/Contents/MacOS/winelauncher"
engine_server="$engine/Contents/MacOS/wineserver"
dxvk="$engine/Contents/Frameworks/render/dxvk/wine"
log_dir="$support_root/logs"

if [[ "$mode" == "--stop" ]]; then
  if [[ -x "$support_root/bin/windows-app-process.py" ]]; then
    exec "$support_root/bin/windows-app-process.py" --stop "${extra_args[@]}"
  fi
  exit 0
fi

show_error() {
  /usr/bin/osascript -e "display alert \"$1\" message \"$2\" as critical" >/dev/null 2>&1 || true
}

if [[ "$(uname -m)" != "x86_64" ]]; then
  show_error "无法启动" "这个启动方式只为 Intel Mac 配置。"
  exit 1
fi

process_args=()
case "$mode" in
  steam)
    launcher="tencent"
    prefix="$HOME/Library/Application Support/com.tencent.yybmac.wine.engine/wine"
    target="$prefix/drive_c/Program Files (x86)/Steam/Steam.exe"
    log_file="$log_dir/steam.log"
    launch_args=()
    ;;
  steam-game)
    game_id="${extra_args[1]:-}"
    install_path="${extra_args[2]:-}"
    if [[ "$game_id" != <-> || -z "$install_path" ]]; then
      show_error "无法启动" "这个 Steam 游戏的启动信息不完整。"
      exit 1
    fi
    launcher="tencent"
    prefix="$HOME/Library/Application Support/com.tencent.yybmac.wine.engine/wine"
    target="$prefix/drive_c/Program Files (x86)/Steam/Steam.exe"
    log_file="$log_dir/steam.log"
    launch_args=(-applaunch "$game_id")
    process_args=("$install_path")
    extra_args=()
    ;;
  netease)
    launcher="tencent"
    prefix="$HOME/Library/Application Support/com.tencent.yybmac.wine.engine/wine"
    fever_root="$prefix/drive_c/Program Files/FeverGames"
    candidates=("$fever_root"/*/FeverGamesInstaller.exe(N.om[1]))
    target="${candidates[1]:-}"
    log_file="$log_dir/netease.log"
    if [[ -n "$target" ]]; then
      export YYB_LIFETIME_EXECUTABLE="${target:h}/FeverGamesWeb.exe"
    fi
    # The old Intel engine cannot finish FeverGames' downloader IPC. A watcher
    # below hands only an explicit Sky download click to the official CDN
    # resume helper while the stable YYB window bridge keeps pumping events.
    launch_args=(
      --no-sandbox
      --in-process-gpu
      --disable-gpu
      --disable-gpu-compositing
      --disable-direct-composition
      --force-device-scale-factor=2
    )
    ;;
  netease-game)
    game_id="${extra_args[1]:-}"
    if [[ "$game_id" != "63" ]]; then
      show_error "无法启动" "目前没有识别到这个网易游戏。"
      exit 1
    fi
    launcher="tencent"
    prefix="$HOME/Library/Application Support/com.tencent.yybmac.wine.engine/wine"
    fever_root="$prefix/drive_c/Program Files/FeverGames"
    fever_candidates=("$fever_root"/*/FeverGamesInstaller.exe(N.om[1]))
    fever_target="${fever_candidates[1]:-}"
    fever_launcher="$fever_root/FeverGamesLauncher.exe"
    target="$prefix/drive_c/FeverApps/sky/Sky.exe"
    log_file="$log_dir/sky.log"
    launch_args=(--start_from_launcher=1)
    # The game id selects the wrapper mode; it is not a Sky.exe argument.
    extra_args=()
    ;;
  *)
    exit 64
    ;;
esac

if [[ -z "$target" || ! -f "$target" ]]; then
  show_error "还没有安装好" "找不到对应的 Windows 启动器文件。"
  exit 1
fi

process_helper="$support_root/bin/windows-app-process.py"
mkdir -p "$log_dir"
if [[ "${YYB_DOCK_HOST:-0}" == "1" && -x "$process_helper" ]] && \
   "$process_helper" --check "$mode" "${process_args[@]}"; then
  exec "$process_helper" --wait "$mode" "${process_args[@]}"
fi

if [[ "$mode" == netease* && -x "$support_root/bin/apply-intel-retina.py" ]]; then
  # preferences.sav is created only after Sky's first run. Re-applying here
  # makes the next launch use the requested 60 FPS and no-motion-blur values.
  "$support_root/bin/apply-intel-retina.py" --fps 60 \
    >>"$log_dir/retina.log" 2>&1 || true
fi

if [[ "$mode" == netease* && -x "$support_root/bin/apply-intel-retina.py" ]]; then
  # The launcher may start Sky itself after QR login. Keep the first-run
  # preference watcher alive in both paths so quality_fps is saved as 60 as
  # soon as the game creates preferences.sav and later exits.
  nohup "$support_root/bin/apply-intel-retina.py" --watch-fps --fps 60 \
    >>"$log_dir/retina.log" 2>&1 </dev/null &!
fi

if [[ "$mode" == "netease" && -x "$support_root/bin/download-sky.py" ]]; then
  nohup "$support_root/bin/download-sky.py" --watch \
    >>"$log_dir/sky-download.log" 2>&1 </dev/null &!
fi

if [[ ! -x "$bridge" ]]; then
  show_error "运行环境不完整" "应用宝的 PC 游戏引擎或启动桥不存在。"
  exit 1
fi

# Steam still uses Tencent's engine app bootstrap. FeverGames lets the native
# bridge own cold-start detection and its in-session retry.
if [[ "$mode" != netease* ]]; then
  engine_cold_start=false
  if ! pgrep -f "$engine_server" >/dev/null 2>&1; then
    engine_cold_start=true
    /usr/bin/open -n \
      --env "GFX_BACKEND_PATH=$dxvk" \
      --env "WINE_RETINA_MODE=1" \
      --env "WINE_RETINA_SCALE=2.0" \
      --env "DXVK_HUD=0" \
      --env "MTL_HUD_ENABLED=0" \
      --env "D3DM_ENABLE_METALFX=0" \
      --env "WINEDEBUG=-all" \
      "$engine"

    for _ in {1..150}; do
      pgrep -f "$engine_server" >/dev/null 2>&1 && break
      sleep 0.1
    done
  fi

  if ! pgrep -f "$engine_server" >/dev/null 2>&1; then
    show_error "PC 游戏引擎没有启动" "请稍后重试；详细信息保存在 YYBIntelLauncher 日志中。"
    exit 1
  fi

  if [[ "$engine_cold_start" == true ]]; then
    sleep 14
  fi
fi

if [[ "$mode" == "steam-game" ]]; then
  # The Steam launcher owns Tencent's Cocoa event pump. Start it first, then
  # send -applaunch through a short-lived Wine client in the same prefix. This
  # mirrors CrossOver/YYB launchers without creating a second Steam instance.
  if ! "$process_helper" --check steam; then
    if [[ -d "/Applications/Steam（Windows）.app" ]]; then
      /usr/bin/open -g "/Applications/Steam（Windows）.app"
    else
      YYB_DOCK_HOST=0 "$support_root/bin/launch-windows-app" steam
    fi
    for _ in {1..240}; do
      "$process_helper" --check steam && break
      sleep 0.25
    done
  fi
  if ! "$process_helper" --check steam; then
    show_error "Windows 版 Steam 没有就绪" "请先打开 Windows 版 Steam 并完成登录。"
    exit 1
  fi

  wine_root="$engine/Contents/SharedSupport/wine"
  frameworks="$engine/Contents/Frameworks"
  cd "${target:h}"
  nohup env \
    YYB_NTDLL_PATH="$wine_root/lib/wine/x86_64-unix/ntdll.so" \
    YYB_WINESERVER_HOST_APP="$support_root/WineServerHost.app" \
    WINEPREFIX="$prefix" \
    WINESERVER="$support_root/wineserver-wrapper" \
    WINELOADER="$support_root/wine-loader" \
    WINEDLLPATH="$wine_root/lib/wine" \
    DYLD_FALLBACK_LIBRARY_PATH="$frameworks" \
    GFX_BACKEND_PATH="$dxvk" \
    WINE_RETINA_MODE=1 WINE_RETINA_SCALE=2.0 WINEDEBUG=-all \
    "$support_root/wine-loader" "$target" "${launch_args[@]}" \
    >>"$log_file" 2>&1 </dev/null &!
  for _ in {1..1200}; do
    if "$process_helper" --check steam-game "${process_args[@]}"; then
      exec "$process_helper" --wait steam-game "${process_args[@]}"
    fi
    sleep 0.25
  done
  show_error "Steam 游戏没有启动" "Steam 已收到启动请求，但没有检测到游戏进程。"
  exit 1
fi

if [[ "$mode" == "netease-game" ]]; then
  # Never launch Sky.exe naked. Its NetEase build obtains an account ticket
  # from FeverGames over local IPC; without that official hand-off UniSDK
  # returns 202 and the game misleadingly reports a network problem.
  if [[ -z "$fever_target" || ! -f "$fever_launcher" ]]; then
    show_error "网易启动器不完整" "找不到负责登录交接的网易启动器组件。"
    exit 1
  fi
  netease_was_started=false
  if ! "$process_helper" --check netease; then
    netease_was_started=true
    if [[ -d "/Applications/网易游戏启动器.app" ]]; then
      /usr/bin/open -g "/Applications/网易游戏启动器.app"
    else
      YYB_DOCK_HOST=0 "$support_root/bin/launch-windows-app" netease
    fi
    for _ in {1..240}; do
      "$process_helper" --check netease && break
      sleep 0.25
    done
  fi
  if ! "$process_helper" --check netease; then
    show_error "网易启动器没有就绪" "请先打开网易游戏启动器并保持登录，再打开光·遇。"
    exit 1
  fi

  # FeverGamesInstaller appears well before its CEF page and IPC receiver are
  # usable. Sending the URL during that gap merely opens a second launcher and
  # loses autoRun. Wait for the web layer on a cold launch, then submit the
  # official URI through Tencent's own Cocoa/Wine bridge. This preserves the
  # NetEase QR-login ticket; launching Sky.exe directly produces UniSDK 202.
  if [[ "$netease_was_started" == true ]]; then
    web_count=0
    for _ in {1..480}; do
      web_count="$(ps -axo comm= 2>/dev/null | grep -c '[F]everGamesWeb' || true)"
      (( web_count >= 2 )) && break
      sleep 0.25
    done
    if (( web_count < 2 )); then
      show_error "网易启动器加载超时" "请退出后重新打开光·遇；游戏和登录数据不会受影响。"
      exit 1
    fi
    sleep 2
  fi

  nohup "$bridge" "$fever_launcher" \
    "fevergames://mygame/?gameId=63&autoRun=1" \
    >>"$log_dir/sky.log" 2>&1 </dev/null &!
  for _ in {1..1200}; do
    if "$process_helper" --check netease-game; then
      exec "$process_helper" --wait netease-game
    fi
    sleep 0.25
  done
  show_error "光·遇没有启动" "网易启动器已经打开；请在其中点击开始游戏。"
  exit 1
fi

cd "${target:h}"
if [[ "${YYB_DOCK_HOST:-0}" == "1" ]]; then
  exec "$bridge" "$target" "${launch_args[@]}" "${extra_args[@]}" >>"$log_file" 2>&1
fi
nohup "$bridge" "$target" "${launch_args[@]}" "${extra_args[@]}" >>"$log_file" 2>&1 </dev/null &!
